# MoodBite AI - Environment Configuration Example
# Duplicate this file to .env.local and populate the values below.

# 1. Google Gemini API Key (Required - Primary LLM for recipe suggestions & ingredient vision)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hugging Face Access Token (Required - RoBERTa GoEmotions emotion classifier)
# Get a token at: https://huggingface.co/settings/tokens
HUGGING_FACE_API_TOKEN=your_hugging_face_token_here

# 3. OpenRouter API Key (Optional / Fallback - Anthropic Claude 3 Haiku)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Pexels API Key (Required - Real Indian dish photography)
# Get a free key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# 5. Rate Limiting Configuration (Optional overrides)
# Window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window per IP for AI endpoints (default: 20)
RATE_LIMIT_MAX_REQUESTS=20

# 6. Supabase Credentials (Required for WP3 Authentication & WP4 Personalization)
# Create a free project at: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

